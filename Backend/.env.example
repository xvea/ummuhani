NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Gunakan database lokal khusus development. Jangan jalankan migrate pada database SIMRS produksi.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/antrian_rs"

# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="isi-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
CLIENT_URL="http://localhost:3000"
# Alternatif beberapa origin, dipisahkan koma:
# CORS_ORIGINS="http://localhost:3000,http://192.168.1.10"

# 32-byte key. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
COOKIE_NAME="rs_queue_token"

# Untuk seed pengembangan saja. Jangan menggunakan kredensial contoh di produksi.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="ganti-password-minimal-8-karakter"
SEED_ADMIN_NAME="Administrator"
SEED_SAMPLE_POLI="true"
