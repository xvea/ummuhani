# Salin file ini menjadi .env.local lalu sesuaikan.

# Alamat Backend (Ummu Hani/Backend) yang dipakai server Next.js.
# Browser cukup memanggil /api dan /socket.io di alamat Frontend; Next.js meneruskannya ke sini.
BACKEND_URL=http://localhost:3001

# Opsional: isi hanya jika browser harus memanggil Backend di alamat lain (default: alamat yang sama)
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=

# Kiosk: ID perangkat dan cetak tiket otomatis (true di perangkat kiosk, false saat pengembangan)
NEXT_PUBLIC_KIOSK_ID=KSK-UMH-01
NEXT_PUBLIC_KIOSK_AUTO_PRINT=false
